# ForeclosureData — shared environment reference.
# Each app (apps/web, apps/worker, apps/mobile) has its own .env.example
# with only the variables it actually needs. This file documents the full
# set and is the source you copy from. Never copy real values from another
# project's environment (including Merchant1 Solutions) — this product has
# its own Supabase project, Stripe account, and secrets.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ForeclosureData"
NEXT_PUBLIC_MARKETING_URL="https://foreclosuredata.io"
NEXT_PUBLIC_APP_URL="https://app.foreclosuredata.io"
NEXT_PUBLIC_DEEP_LINK_SCHEME="foreclosuredata"
ADMIN_EMAIL=""

# ─── Supabase (single backend for web + mobile) ──────────────────────────────
# Create a dedicated ForeclosureData Supabase project at https://supabase.com
# (do not reuse another product's project), or run `supabase start` locally
# with the Supabase CLI for a full local stack.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Database (direct Postgres connection, used by Prisma) ──────────────────
# Supabase project settings → Database → Connection string (use the
# "Transaction" pooler URL in serverless deployments). Local dev uses the
# docker-compose Postgres below instead.
DATABASE_URL="postgresql://foreclosuredata:foreclosuredata_dev_password@localhost:5433/foreclosuredata"
DIRECT_URL="postgresql://foreclosuredata:foreclosuredata_dev_password@localhost:5433/foreclosuredata"

# ─── Billing provider selection ───────────────────────────────────────────────
# authorize_net | stripe | mock (mock is the safe default for local dev/tests —
# it never calls a real payment gateway). Per-plan price/plan references live
# in the PlanMapping table, not env vars — see docs/BILLING.md.
BILLING_PROVIDER="mock"
PAYMENT_FAILURE_GRACE_PERIOD_DAYS="7"

# ─── Stripe (test/live mode; kept available as a fallback provider) ─────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Authorize.net (sandbox during development; Merchant1 Solutions merchant account) ─
# Never commit real values. Uses Accept Hosted (checkout) + ARB (recurring
# billing) — raw card numbers never touch this server.
AUTHORIZE_NET_ENVIRONMENT="sandbox"
AUTHORIZE_NET_API_LOGIN_ID=""
AUTHORIZE_NET_TRANSACTION_KEY=""
AUTHORIZE_NET_SIGNATURE_KEY=""
AUTHORIZE_NET_CLIENT_KEY=""
AUTHORIZE_NET_WEBHOOK_SECRET=""

# ─── AI extraction (Layer 2, optional — worker only) ─────────────────────────
AI_PROVIDER_API_KEY=""
AI_EXTRACTION_MODEL="claude-sonnet-5"
AI_MONTHLY_BUDGET_CENTS="2000"
OCR_PROVIDER_API_KEY=""
OCR_MONTHLY_BUDGET_CENTS="1000"
BUDGET_ALERT_THRESHOLD_PCT="80"

# ─── Object storage for source documents (worker + web document viewer) ─────
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
DOCUMENT_STORAGE_BUCKET="foreclosure-notices"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Geocoding (worker only; used only after a probable address is found) ───
GEOCODING_PROVIDER="none"
GEOCODING_API_KEY=""

# ─── Job runner / worker ─────────────────────────────────────────────────────
JOBS_RUN_SECRET=""

# ─── Push notifications (future delivery adapters) ───────────────────────────
EXPO_ACCESS_TOKEN=""
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# ─── Founding-member promotion (see docs/BACKLOG.md) ─────────────────────────
FOUNDING_MEMBER_SLOTS="100"
FOUNDING_MEMBER_FREE_MONTHS="3"
