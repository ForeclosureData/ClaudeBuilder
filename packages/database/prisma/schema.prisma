// ForeclosureData — database schema
//
// This schema is Prisma's source of truth for every table in the `public`
// schema. It intentionally does NOT model Supabase's `auth.users` table —
// Prisma should never migrate that table. Two things are applied separately
// against a real Supabase Postgres instance (see sql/rls.sql):
//   1. `ALTER TABLE profiles ADD CONSTRAINT ... FOREIGN KEY (id) REFERENCES auth.users(id)`
//   2. Row Level Security policies on every table.
// Local dev (docker-compose Postgres) has no `auth` schema at all, so those
// statements are skipped there — `Profile.id` is just a free-standing uuid.

generator client {
  provider      = "prisma-client-js"
  // Both x86_64 and arm64 Amazon Linux targets: Netlify Functions'
  // underlying Lambda architecture isn't guaranteed, so build both and let
  // Prisma auto-select the matching one for whichever process.arch it's
  // actually running under, rather than guessing at deploy-config time.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

/// FREE: browse-only preview, no county fully unlocked.
/// COUNTY: full access to exactly one county (Subscription.selectedCountyId).
/// UNLIMITED: full access to every Texas county.
enum PlanKey {
  FREE
  COUNTY
  UNLIMITED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAYMENT_FAILED
  CANCELED
  EXPIRED
  PROMOTIONAL
  INCOMPLETE
  INACTIVE
}

/// Which payment processor actually owns a subscription/customer/transaction.
/// The entitlement system never branches on this — see packages/auth/src/entitlement.ts.
enum BillingProviderKind {
  STRIPE
  AUTHORIZE_NET
  MOCK
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Internal, provider-agnostic plan SKUs. Never hardcode a Stripe price ID
/// or an Authorize.net ARB plan reference in application logic — look it
/// up in PlanMapping by (internalPlanId, billingProvider) instead.
enum InternalPlanId {
  county_monthly
  county_annual
  texas_monthly
  texas_annual
}

enum PaymentEventType {
  CHARGE_SUCCEEDED
  CHARGE_FAILED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  REFUND_ISSUED
}

enum DocumentType {
  NOTICE_OF_TRUSTEE_SALE
  AMENDED_NOTICE
  CANCELLATION_NOTICE
  POSTPONEMENT_NOTICE
  DEED_OF_TRUST
  ASSIGNMENT_OF_LIEN
  OTHER
  UNKNOWN
}

enum DocumentProcessingStatus {
  DISCOVERED
  DOWNLOADED
  TEXT_EXTRACTED
  DETERMINISTIC_EXTRACTED
  AI_EXTRACTED
  RESOLVED
  SUMMARIZED
  FAILED
  DUPLICATE
}

enum ManualReviewStatus {
  NOT_NEEDED
  PENDING
  IN_REVIEW
  RESOLVED
}

enum SaleStatus {
  SCHEDULED
  POSTPONED
  CANCELED
  SOLD
  UNKNOWN
}

enum CancellationStatus {
  NOT_CANCELED
  CANCELED
  WITHDRAWN
  UNKNOWN
}

enum PartyEntityType {
  INDIVIDUAL
  ENTITY
  UNKNOWN
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY
  CONDO
  TOWNHOUSE
  MOBILE_HOME
  VACANT_LAND
  COMMERCIAL
  OTHER
  UNKNOWN
}

enum PropertyClassification {
  RESIDENTIAL
  COMMERCIAL
  UNKNOWN
}

enum AddressResolutionMethod {
  EXPLICIT_STATED
  COMMONLY_KNOWN_AS_PHRASE
  LEGAL_DESCRIPTION_MATCH
  PROPERTY_ID_MATCH
  GEOGRAPHIC_ID_MATCH
  OWNER_MAILING_ADDRESS_MATCH
  MULTI_FIELD_MATCH
  GEOCODING
  /// A resolution reused from ResolvedLegalDescriptionMatch instead of a
  /// fresh CAD search — see resolver caching in the property-resolution
  /// admin screen's searchAgain action.
  CACHED_MATCH_REUSE
  MANUAL
  UNRESOLVED
}

/// Generic valuation "kind" a PropertyValuation row carries. Zestimate is a
/// Zillow trademark — ZESTIMATE must only ever be used for a value that
/// actually came from an authorized Zillow integration (see ZillowAuthorizedProvider).
enum ValuationType {
  ZESTIMATE
  COUNTY_APPRAISED_VALUE
  COUNTY_MARKET_VALUE
  THIRD_PARTY_AVM
  INTERNAL_ESTIMATE
}

enum FieldSourceType {
  FORECLOSURE_NOTICE
  COUNTY_CLERK
  APPRAISAL_DISTRICT
  GEOCODING_SERVICE
  THIRD_PARTY_DATA
  CALCULATED
  MANUAL
}

enum ManualReviewReason {
  NO_ADDRESS_RESOLVED
  MULTIPLE_APPRAISAL_MATCHES
  SALE_DATE_CONFLICT
  BORROWER_NAME_CONFLICT
  POOR_TEXT_QUALITY
  PROPERTY_CLASSIFICATION_UNCERTAIN
  LOW_CONFIDENCE
  USER_REPORTED
  /// The CAD's current-owner-of-record for the best-matching candidate
  /// conflicts with the foreclosure's borrower/grantor -- never auto-
  /// accepted regardless of how well other fields (address/lot/block)
  /// matched. Distinct from MULTIPLE_APPRAISAL_MATCHES so a reviewer can
  /// tell "the county record itself points at a different owner" apart
  /// from "we found several plausible candidates and couldn't pick one".
  CAD_OWNER_CONFLICT
  /// No county filing number could be extracted/parsed from this notice --
  /// the composite (countyId, countyFilingNumber) dedup/identity check has
  /// nothing to compare against, so this case's uniqueness was never
  /// verified against already-ingested notices. Never silently treated as
  /// "must be new"; always routed here for a human to confirm it isn't a
  /// duplicate of an existing case before treating it as authoritative.
  MISSING_FILING_NUMBER
  /// A PossibleDuplicateNoticeLink at LIKELY_SAME_EVENT or
  /// CONFIRMED_SAME_EVENT confidence was created for this case -- routes it
  /// into the existing manual-review queue without touching the case's own
  /// identity/publication fields. See PossibleDuplicateNoticeLink for the
  /// full evidence record.
  POSSIBLE_CONTENT_DUPLICATE
}

enum ManualReviewTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ProcessingJobType {
  DISCOVER_NOTICES
  DOWNLOAD_DOCUMENT
  EXTRACT_TEXT
  OCR_PAGE
  DETERMINISTIC_EXTRACT
  AI_EXTRACT
  ADDRESS_RESOLUTION
  GENERATE_SUMMARY
  RECHECK_NOTICE
  APPRAISAL_PROPERTY_SEARCH
  APPRAISAL_PROPERTY_DETAILS_FETCH
  PROPERTY_CANDIDATE_SCORING
  PROPERTY_MATCH_REVIEW
  VALUATION_PROVIDER_LOOKUP
  VALUATION_REFRESH
  STALE_VALUATION_CLEANUP
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum OrganizationType {
  LENDER
  SERVICER
  TRUSTEE_COMPANY
  TITLE_COMPANY
  LAW_FIRM
  OTHER
}

enum CorrectionStatus {
  OPEN
  REVIEWED
  APPLIED
  REJECTED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationEventType {
  NEW_MATCHING_PROPERTY
  ADDRESS_RESOLVED
  SALE_DATE_CHANGED
  SALE_CANCELED
  SAVED_PROPERTY_REMINDER
  UPCOMING_AUCTION_REMINDER
}

enum NotificationChannel {
  EMAIL
  WEB_PUSH
  EXPO_PUSH
}

// ─────────────────────────────────────────────────────────────────────────
// Users, plans, subscriptions
// ─────────────────────────────────────────────────────────────────────────

/// Mirrors auth.users 1:1 (id is the Supabase auth user id). See header note.
model Profile {
  id        String   @id
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription            Subscription?
  savedProperties         SavedProperty[]
  correctionReportsFiled  CorrectionReport[]      @relation("CorrectionReportedBy")
  correctionReportsClosed CorrectionReport[]      @relation("CorrectionResolvedBy")
  exportJobs              ExportJob[]
  notificationPreference  NotificationPreference?
  notificationEvents      NotificationEvent[]
  auditLogs               AuditLog[]
  manualReviewAssignments ManualReviewTask[]
  paymentEvents           PaymentEvent[]

  @@map("profiles")
}

model PlanConfig {
  id                     String   @id @default(uuid())
  planKey                PlanKey  @unique @map("plan_key")
  name                   String
  priceCents             Int      @map("price_cents")
  monthlyCsvExportLimit  Int      @default(0) @map("monthly_csv_export_limit")
  maxSavedProperties     Int      @default(10) @map("max_saved_properties")
  canViewDocuments       Boolean  @default(false) @map("can_view_documents")
  canReceiveAlerts       Boolean  @default(false) @map("can_receive_alerts")
  canViewRecordHistory   Boolean  @default(false) @map("can_view_record_history")
  availableCountySlugs   String[] @default([]) @map("available_county_slugs")
  description            String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("plan_configs")
}

model Subscription {
  id        String             @id @default(uuid())
  profileId String             @unique @map("profile_id")
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan      PlanKey            @default(FREE)
  status    SubscriptionStatus @default(INACTIVE)

  /// Provider-agnostic entitlement stays driven by `plan`/`status` above —
  /// everything below is billing-mechanics detail the entitlement resolver
  /// never inspects.
  billingProvider        BillingProviderKind? @map("billing_provider")
  internalPlanId         InternalPlanId?      @map("internal_plan_id")
  billingInterval        BillingInterval?     @map("billing_interval")
  externalCustomerId     String?              @map("external_customer_id")
  externalSubscriptionId String?              @unique @map("external_subscription_id")

  currentPeriodEnd        DateTime? @map("current_period_end")
  csvExportsUsedThisMonth Int       @default(0) @map("csv_exports_used_this_month")
  csvExportsResetAt       DateTime? @map("csv_exports_reset_at")

  /// Only meaningful when plan = COUNTY — which single county this subscriber unlocked.
  selectedCountyId String? @map("selected_county_id")
  selectedCounty   County? @relation(fields: [selectedCountyId], references: [id], onDelete: SetNull)

  trialEndsAt          DateTime? @map("trial_ends_at")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")

  /// Failed-payment handling: access continues until this passes, then the
  /// resolver falls back to FREE. Configured via PAYMENT_FAILURE_GRACE_PERIOD_DAYS.
  paymentGracePeriodEndsAt DateTime? @map("payment_grace_period_ends_at")

  /// Founding-member promotion — explicitly per-subscriber and admin-approved,
  /// never assumed for every early signup.
  isFoundingMember         Boolean   @default(false) @map("is_founding_member")
  foundingMemberApprovedById String? @map("founding_member_approved_by_id")
  foundingMemberApprovedAt  DateTime? @map("founding_member_approved_at")
  promotionalMonthsGranted Int?      @map("promotional_months_granted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentEvents PaymentEvent[]

  @@map("subscriptions")
}

/// Maps an internal plan SKU to whatever a given billing provider calls it.
/// One internalPlanId can have a row per provider — application code must
/// look prices/refs up here, never hardcode a Stripe price ID or an
/// Authorize.net ARB plan reference.
model PlanMapping {
  id              String              @id @default(uuid())
  internalPlanId  InternalPlanId      @map("internal_plan_id")
  billingProvider BillingProviderKind @map("billing_provider")
  externalRef     String              @map("external_ref")
  billingInterval BillingInterval     @map("billing_interval")
  priceCents      Int                 @map("price_cents")
  currency        String              @default("usd")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([internalPlanId, billingProvider])
  @@map("plan_mappings")
}

/// One row per real money movement (charge, refund) or subscription
/// lifecycle event, regardless of provider — powers the account billing
/// page's payment history.
model PaymentEvent {
  id                  String            @id @default(uuid())
  profileId           String            @map("profile_id")
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subscriptionId      String?           @map("subscription_id")
  subscription        Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingProvider     BillingProviderKind @map("billing_provider")
  type                PaymentEventType
  externalTransactionId String?         @map("external_transaction_id")
  amountCents         Int?              @map("amount_cents")
  currency            String?           @default("usd")
  status              String?
  occurredAt          DateTime          @default(now()) @map("occurred_at")
  rawPayload          Json?             @map("raw_payload")

  @@index([profileId])
  @@map("payment_events")
}

/// Idempotency guard for provider webhooks — the unique constraint is what
/// actually prevents double-processing a redelivered event, not application
/// logic alone.
model WebhookEvent {
  id              String              @id @default(uuid())
  billingProvider BillingProviderKind @map("billing_provider")
  externalEventId String              @map("external_event_id")
  eventType       String              @map("event_type")
  receivedAt      DateTime            @default(now()) @map("received_at")
  processedAt     DateTime?           @map("processed_at")
  payload         Json

  @@unique([billingProvider, externalEventId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Counties & sources
// ─────────────────────────────────────────────────────────────────────────

/// Where a county stands in the rollout pipeline (docs/COUNTY_ROADMAP.md).
/// The public site must only ever present SUPPORTED counties as available —
/// everything else is "coming soon" / not yet on the platform.
enum CountyAvailabilityStatus {
  REQUESTED
  RESEARCHING
  CONNECTOR_DEVELOPMENT
  TESTING
  SUPPORTED
  TEMPORARILY_UNAVAILABLE
  DEPRECATED
}

/// How a county's notices are actually obtained. Adapters must never bypass
/// CAPTCHA, authentication, or rate limits — a county requiring more than an
/// adapter can safely automate stays at MANUAL_ADMINISTRATOR_UPLOAD or
/// PUBLIC_INFORMATION_REQUEST_IMPORT until that changes.
enum SourceAccessMethod {
  DIRECT_HTTP_DOWNLOAD
  HTML_PAGE_PARSING
  VENDOR_SEARCH_PORTAL
  BROWSER_AUTOMATION
  OFFICIAL_API
  APPROVED_BULK_DATA_FEED
  PUBLIC_INFORMATION_REQUEST_IMPORT
  MANUAL_ADMINISTRATOR_UPLOAD
}

enum ConnectorHealth {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum CountyRequestStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  FULFILLED
  DECLINED
}

/// Per-state jurisdictional configuration, so Texas-specific foreclosure
/// procedure/terminology/timelines never get hardcoded into shared domain
/// models — a future state ships by adding a row here, not by editing
/// ForeclosureCase/Loan/etc.
model StateConfig {
  stateCode              String   @id @map("state_code") // e.g. "TX"
  name                   String
  foreclosureProcedureNotes String? @map("foreclosure_procedure_notes")
  /// e.g. { "sale": "foreclosure sale", "trustee": "substitute trustee" } — labels this state's documents use for shared concepts.
  noticeTerminology      Json?    @map("notice_terminology")
  statutoryNoticeDays    Int?     @map("statutory_notice_days")
  courtSystemNotes       String?  @map("court_system_notes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  counties County[]

  @@map("state_configs")
}

model County {
  id        String                    @id @default(uuid())
  name      String
  state     String                    @default("TX")
  stateConfig StateConfig?            @relation(fields: [state], references: [stateCode])
  fipsCode  String?                   @map("fips_code")
  slug      String                    @unique
  /// Convenience flag kept in sync with availabilityStatus == SUPPORTED — cheaper for the public-facing queries that just need "can I show this county."
  isActive  Boolean                   @default(false) @map("is_active")
  availabilityStatus CountyAvailabilityStatus @default(REQUESTED) @map("availability_status")
  estimatedPopulation Int?            @map("estimated_population")
  timezone  String                    @default("America/Chicago")
  createdAt DateTime                  @default(now()) @map("created_at")

  sources          CountySource[]
  properties       Property[]
  foreclosureCases ForeclosureCase[]
  sourceDocuments  SourceDocument[]
  subscriptions    Subscription[]
  requests         CountyRequest[]
  resolvedLegalDescriptionMatches ResolvedLegalDescriptionMatch[]
  ingestedNoticeBundles IngestedNoticeBundle[]

  @@map("counties")
}

/// Tracks a single bundled-document posting (e.g. Hidalgo's monthly
/// consolidated "PROPERTY SALE" PDF) discovered by a county adapter's
/// discoverNotices(), independent of the individual notices it contains
/// once split. Lets the ingestion job skip re-downloading/re-splitting an
/// unchanged bundle on every poll, while still noticing when the county
/// republishes a posting with a different sha256 (revision/amendment).
model IngestedNoticeBundle {
  id         String @id @default(uuid())
  countyId   String @map("county_id")
  county     County @relation(fields: [countyId], references: [id], onDelete: Cascade)
  adapterKey String @map("adapter_key")
  externalId String @map("external_id")

  sourceUrl         String                @map("source_url")
  documentUrl       String                @map("document_url")
  bundleSha256      String?               @map("bundle_sha256")
  noticeCount       Int?                  @map("notice_count")
  splitSuccessCount Int?                  @map("split_success_count")
  status            IngestedBundleStatus  @default(DISCOVERED)
  errorMessage      String?               @map("error_message")

  discoveredAt  DateTime  @default(now()) @map("discovered_at")
  processedAt   DateTime? @map("processed_at")
  lastCheckedAt DateTime  @default(now()) @map("last_checked_at")

  @@unique([countyId, adapterKey, externalId])
  @@index([status])
  @@map("ingested_notice_bundles")
}

enum IngestedBundleStatus {
  DISCOVERED
  DOWNLOADING
  SPLITTING
  SPLIT_COMPLETE
  FAILED
}

/// A county a visitor asked us to add — the primary demand signal feeding
/// the expansion roadmap's "user requests" prioritization criterion.
model CountyRequest {
  id                      String              @id @default(uuid())
  requestedCountyName     String              @map("requested_county_name")
  state                   String              @default("TX")
  matchedCountyId         String?             @map("matched_county_id")
  matchedCounty           County?             @relation(fields: [matchedCountyId], references: [id], onDelete: SetNull)
  requesterEmail          String?             @map("requester_email")
  notes                   String?
  status                  CountyRequestStatus @default(OPEN)
  createdAt               DateTime            @default(now()) @map("created_at")

  @@index([state, requestedCountyName])
  @@map("county_requests")
}

model CountySource {
  id                        String              @id @default(uuid())
  countyId                  String              @map("county_id")
  county                    County              @relation(fields: [countyId], references: [id], onDelete: Cascade)
  name                      String
  baseUrl                   String              @map("base_url")
  adapterKey                String              @map("adapter_key")
  isEnabled                 Boolean             @default(false) @map("is_enabled")
  pollIntervalMinutes       Int                 @default(1440) @map("poll_interval_minutes")

  sourceVendor              String?             @map("source_vendor")
  accessMethod              SourceAccessMethod? @map("access_method")
  directDownloadsAvailable  Boolean?            @map("direct_downloads_available")
  authenticationRequired    Boolean?            @map("authentication_required")
  captchaPresent            Boolean?            @map("captcha_present")
  documentsHaveEmbeddedText Boolean?            @map("documents_have_embedded_text")
  ocrUsuallyRequired        Boolean?            @map("ocr_usually_required")
  knownAccessRestrictions   String?             @map("known_access_restrictions")
  connectorHealth           ConnectorHealth     @default(UNKNOWN) @map("connector_health")

  lastAttemptAt             DateTime?           @map("last_attempt_at")
  lastSuccessfulSyncAt      DateTime?           @map("last_successful_sync_at")
  lastErrorMessage          String?             @map("last_error_message")

  // Pilot / rollout KPIs (docs/COUNTY_ROADMAP.md) — raw counters; rates are
  // computed from these plus ProcessingJob/ManualReviewTask data for the
  // admin dashboard rather than duplicated as separately-maintained fields.
  noticesDiscoveredCount    Int      @default(0) @map("notices_discovered_count")
  documentsDownloadedCount  Int      @default(0) @map("documents_downloaded_count")
  documentsProcessedCount   Int      @default(0) @map("documents_processed_count")
  downloadFailureCount      Int      @default(0) @map("download_failure_count")
  extractionFailureCount    Int      @default(0) @map("extraction_failure_count")
  addressResolvedCount      Int      @default(0) @map("address_resolved_count")
  manualReviewCount         Int      @default(0) @map("manual_review_count")
  falseMatchReportedCount   Int      @default(0) @map("false_match_reported_count")
  cancellationsDetectedCount Int     @default(0) @map("cancellations_detected_count")
  connectorFailureCount     Int      @default(0) @map("connector_failure_count")
  totalProcessingCostCents  Int      @default(0) @map("total_processing_cost_cents")
  approxMonthlyNoticeVolume Int?     @map("approx_monthly_notice_volume")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sourceDocuments SourceDocument[]
  processingJobs  ProcessingJob[]

  @@map("county_sources")
}

/// Registry of provenance sources referenced by ExtractedField.sourceUrl /
/// admin health widgets (e.g. "hidalgo_county_clerk", "google_geocoding").
model DataSource {
  id        String           @id @default(uuid())
  key       String           @unique
  name      String
  type      FieldSourceType
  baseUrl   String?          @map("base_url")
  isEnabled Boolean          @default(true) @map("is_enabled")

  @@map("data_sources")
}

// ─────────────────────────────────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────────────────────────────────

model SourceDocument {
  id                   String                   @id @default(uuid())
  countyId             String                   @map("county_id")
  county               County                   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  countySourceId       String?                  @map("county_source_id")
  countySource         CountySource?            @relation(fields: [countySourceId], references: [id], onDelete: SetNull)
  foreclosureCaseId    String?                  @map("foreclosure_case_id")
  foreclosureCase      ForeclosureCase?         @relation(fields: [foreclosureCaseId], references: [id], onDelete: SetNull)

  sourceUrl            String                   @map("source_url")
  documentUrl          String                   @map("document_url")
  filename             String
  countyFilingNumber   String?                  @map("county_filing_number")
  filingDate           DateTime?                @map("filing_date")
  documentType         DocumentType             @default(UNKNOWN) @map("document_type")
  pageCount            Int?                     @map("page_count")
  dateCollected        DateTime                 @default(now()) @map("date_collected")
  dateLastChecked      DateTime                 @default(now()) @map("date_last_checked")
  /// Content hash of this specific file's rendered bytes -- provenance and
  /// change-detection only (e.g. "did the county re-post this exact
  /// document with different bytes"), never notice IDENTITY. Deliberately
  /// not unique: the same real notice can legitimately produce different
  /// bytes across re-renders (non-deterministic image encoding, the county
  /// re-posting a revised scan, etc.), and conflating "different bytes"
  /// with "different notice" is exactly the bug that caused duplicate
  /// ForeclosureCase rows for the same real filing. Identity now lives on
  /// ForeclosureCase.countyFilingNumber (see there for the composite
  /// unique constraint).
  sha256Hash           String                   @map("sha256_hash")
  storageKey           String?                  @map("storage_key")
  extractionVersion    Int                      @default(1) @map("extraction_version")
  extractionConfidence Float?                   @map("extraction_confidence")
  manualReviewStatus   ManualReviewStatus       @default(NOT_NEEDED) @map("manual_review_status")
  language             String?                  @default("en")
  ocrUsed              Boolean                  @default(false) @map("ocr_used")
  processingCostCents  Int                      @default(0) @map("processing_cost_cents")
  status               DocumentProcessingStatus @default(DISCOVERED)
  rawText              String?                  @map("raw_text")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  extractedFields  ExtractedField[]
  legalDescriptions LegalDescription[]
  foreclosureSales ForeclosureSale[]
  manualReviewTasks ManualReviewTask[]
  processingJobs   ProcessingJob[]

  @@index([countyId])
  @@index([foreclosureCaseId])
  @@index([manualReviewStatus])
  @@index([sha256Hash])
  @@map("source_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// People & organizations
// ─────────────────────────────────────────────────────────────────────────

/// Deliberately thin. Phone/email are nullable and unpopulated in the MVP —
/// see product requirement: no personal phone/email exposure without a
/// lawful-sourcing/vendor review.
model Person {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  mailingAddress String?  @map("mailing_address")
  phone          String?
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  casesAsBorrower    ForeclosureCase[] @relation("CaseBorrower")
  casesAsGrantor     ForeclosureCase[] @relation("CaseGrantor")
  casesAsOwner       ForeclosureCase[] @relation("CaseCurrentOwner")
  trustees           Trustee[]

  @@index([fullName])
  @@map("people")
}

model Organization {
  id             String            @id @default(uuid())
  name           String
  type           OrganizationType  @default(OTHER)
  mailingAddress String?           @map("mailing_address")
  phone          String?
  createdAt      DateTime          @default(now()) @map("created_at")

  loansAsOriginalLender  Loan[]     @relation("LoanOriginalLender")
  loansAsCurrentMortgagee Loan[]    @relation("LoanCurrentMortgagee")
  loansAsServicer        Loan[]     @relation("LoanServicer")
  trustees               Trustee[]

  @@index([name])
  @@map("organizations")
}

model Trustee {
  id             String        @id @default(uuid())
  personId       String?       @map("person_id")
  person         Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  phone          String?
  mailingAddress String?       @map("mailing_address")
  createdAt      DateTime      @default(now()) @map("created_at")

  sales ForeclosureSale[]

  @@map("trustees")
}

// ─────────────────────────────────────────────────────────────────────────
// Foreclosure case / sale / loan
// ─────────────────────────────────────────────────────────────────────────

/// The durable "this borrower's foreclosure situation" record. Multiple
/// SourceDocuments (original notice, amendment, cancellation) and multiple
/// ForeclosureSales (postponements) attach to one case over time.
model ForeclosureCase {
  id                String          @id @default(uuid())
  countyId          String          @map("county_id")
  county            County          @relation(fields: [countyId], references: [id], onDelete: Cascade)
  propertyId        String?         @map("property_id")
  property          Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  caseNumber        String?         @map("case_number")
  /// Stable notice identity: the county's own filing number, normalized
  /// (see normalizeCountyFilingNumber() in foreclosure-core). Distinct from
  /// `caseNumber`, which is a display string ("HID-117634"). This is the
  /// field the composite (countyId, countyFilingNumber) identity/dedup
  /// check and unique constraint below are built on -- NOT a content hash,
  /// which only ever reflects how a specific file was rendered, not which
  /// real-world notice it is. Set to null when this case is archived as a
  /// duplicate (see archivedAt) so the unique constraint only ever applies
  /// to the one active/canonical case per real notice -- the original
  /// value is preserved in `archivedReason` for audit purposes.
  countyFilingNumber String? @map("county_filing_number")
  status            SaleStatus      @default(SCHEDULED)
  entityType        PartyEntityType @default(UNKNOWN) @map("entity_type")
  ownerOccupied     Boolean?        @map("owner_occupied")
  homestead         Boolean?

  borrowerPersonId    String? @map("borrower_person_id")
  borrower            Person? @relation("CaseBorrower", fields: [borrowerPersonId], references: [id], onDelete: SetNull)
  grantorPersonId     String? @map("grantor_person_id")
  grantor             Person? @relation("CaseGrantor", fields: [grantorPersonId], references: [id], onDelete: SetNull)
  currentOwnerPersonId String? @map("current_owner_person_id")
  currentOwner        Person? @relation("CaseCurrentOwner", fields: [currentOwnerPersonId], references: [id], onDelete: SetNull)
  coOwnerNames        String[] @default([]) @map("co_owner_names")

  summaryText        String?   @map("summary_text")
  summaryGeneratedAt DateTime? @map("summary_generated_at")
  lastVerifiedAt     DateTime? @map("last_verified_at")

  /// Set only when this case has been identified as a duplicate of another
  /// (real-world-identical) case and archived -- never hard-deleted, so its
  /// history/audit trail stays intact and queryable. Every public-facing
  /// and admin listing query must filter `archivedAt: null`.
  archivedAt     DateTime? @map("archived_at")
  /// Why this case was archived (includes its original countyFilingNumber
  /// for audit, since that field itself is cleared on archive).
  archivedReason String?   @map("archived_reason")
  mergedIntoCaseId String?           @map("merged_into_case_id")
  mergedInto        ForeclosureCase? @relation("CaseMerge", fields: [mergedIntoCaseId], references: [id], onDelete: SetNull)
  mergedDuplicates  ForeclosureCase[] @relation("CaseMerge")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents         SourceDocument[]
  sales             ForeclosureSale[]
  loan              Loan?
  addressCandidates PropertyAddress[]
  legalDescriptions LegalDescription[]
  manualReviewTasks ManualReviewTask[]
  correctionReports CorrectionReport[]
  processingJobs    ProcessingJob[]
  appraisalCandidates  AppraisalPropertyCandidate[]
  resolutionAttempts   PropertyResolutionAttempt[]
  duplicateLinksAsCaseA PossibleDuplicateNoticeLink[] @relation("DuplicateLinkCaseA")
  duplicateLinksAsCaseB PossibleDuplicateNoticeLink[] @relation("DuplicateLinkCaseB")

  // Re-enabled after the production-safety review confirmed zero duplicate
  // (countyId, countyFilingNumber) rows in production (all current rows
  // predate this field and carry countyFilingNumber: null, which Postgres
  // never treats as colliding with another null under a unique constraint --
  // this only starts actually constraining once the ingestion pipeline
  // populates real values, which is exactly the protection it exists for).
  // Was previously deferred here as "TEMPORARILY NOT ENFORCED" while 33
  // duplicate rows existed; see git history and docs/DEPLOYMENT.md for that
  // incident.
  @@unique([countyId, countyFilingNumber])
  @@index([countyId])
  @@index([propertyId])
  @@index([status])
  @@index([archivedAt])
  @@map("foreclosure_cases")
}

/// Confidence tier for a PossibleDuplicateNoticeLink -- how strong the
/// combined evidence is that two DISTINCT county filings (different
/// countyFilingNumber, each its own legally meaningful ForeclosureCase)
/// represent the same real-world foreclosure event. Deliberately separate
/// from ForeclosureCase.archivedAt/mergedIntoCaseId, which is the existing
/// mechanism for a LITERAL duplicate re-ingestion of the SAME filing
/// number -- this enum is for two filings that are each real, distinct
/// source records that may just describe one underlying event (real
/// example: HID-117729 and HID-117731, second fresh-25 batch, 2026-08-09).
enum NoticeDuplicateConfidence {
  /// Near-certain: either a shared trustee/servicer tracking number (e.g.
  /// the same "T.S. #" appearing in both notices' raw text) plus matching
  /// core fields, or a near-identical normalized raw-text fingerprint,
  /// with zero conflicting fields.
  CONFIRMED_SAME_EVENT
  /// Several independent core fields match (address, legal description,
  /// borrower names, principal, sale date, lender) with zero conflicts,
  /// but no single decisive signal (tracking number / text fingerprint).
  LIKELY_SAME_EVENT
  /// Some matching evidence, but thinner than LIKELY_SAME_EVENT (e.g. only
  /// two independent fields agree) -- worth a human look, not strong
  /// enough to act on.
  POSSIBLE_DUPLICATE
}

enum NoticeDuplicateLinkStatus {
  /// Newly detected, not yet reviewed by a human.
  OPEN
  /// A reviewer confirmed these two cases do represent the same real-world
  /// event. Cases stay separate, distinct ForeclosureCase rows -- this
  /// status only changes how they're counted/displayed, per the
  /// SOURCE RECORD COUNT vs UNIQUE FORECLOSURE EVENT COUNT distinction
  /// (see docs/DEPLOYMENT.md). Never triggers a merge/archive.
  CONFIRMED_DUPLICATE
  /// A reviewer determined these are in fact distinct real-world events
  /// (e.g. two separate liens on the same property, or an amended
  /// re-filing that changed a material term) despite the matching
  /// evidence.
  REJECTED_DISTINCT
}

/// A detected (or reviewer-confirmed) signal that two DISTINCT
/// ForeclosureCase rows -- each its own legally meaningful county filing,
/// never merged, never archived by this mechanism -- may represent the
/// same underlying real-world foreclosure event. See
/// NoticeDuplicateConfidence for what "may represent" means at each tier.
/// caseAId is always the lexicographically smaller of the two case IDs
/// (enforced by the detection engine, not the database) so a given pair
/// only ever gets one row regardless of comparison order.
model PossibleDuplicateNoticeLink {
  id     String          @id @default(uuid())
  caseAId String          @map("case_a_id")
  caseA   ForeclosureCase @relation("DuplicateLinkCaseA", fields: [caseAId], references: [id], onDelete: Cascade)
  caseBId String          @map("case_b_id")
  caseB   ForeclosureCase @relation("DuplicateLinkCaseB", fields: [caseBId], references: [id], onDelete: Cascade)

  confidence NoticeDuplicateConfidence
  /// 0-1 combined weighted-evidence score behind `confidence` -- see
  /// scoreDuplicateEvidence() in foreclosure-core for how it's computed.
  score Float
  /// Field names both cases agree on (e.g. "propertyAddress",
  /// "legalDescription", "borrowerNames", "originalPrincipalAmount",
  /// "saleDate", "lenderName", "deedOfTrustDate", "trusteeSaleTrackingNumber",
  /// "rawTextFingerprint").
  matchedFields String[] @default([]) @map("matched_fields")
  /// Field names that explicitly DISAGREE between the two cases (e.g. a
  /// different sale date) -- present, any conflict caps the confidence
  /// tier regardless of how many fields matched.
  conflictingFields String[] @default([]) @map("conflicting_fields")
  /// Human-readable summary of the evidence, generated by the detection
  /// engine.
  explanation String?

  status           NoticeDuplicateLinkStatus @default(OPEN)
  reviewedByUserId String?                   @map("reviewed_by_user_id")
  reviewedAt       DateTime?                 @map("reviewed_at")
  reviewNotes      String?                   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([caseAId, caseBId])
  @@index([caseAId])
  @@index([caseBId])
  @@index([status])
  @@map("possible_duplicate_notice_links")
}

model ForeclosureSale {
  id                 String              @id @default(uuid())
  foreclosureCaseId  String              @map("foreclosure_case_id")
  foreclosureCase    ForeclosureCase     @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)
  sourceDocumentId   String?             @map("source_document_id")
  sourceDocument     SourceDocument?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  saleDate           DateTime?           @map("sale_date")
  saleTime           String?             @map("sale_time")
  saleLocation       String?             @map("sale_location")
  noticePostingDate  DateTime?           @map("notice_posting_date")
  earliestSaleDate   DateTime?           @map("earliest_sale_date")
  saleStatus         SaleStatus          @default(SCHEDULED) @map("sale_status")
  cancellationStatus CancellationStatus  @default(NOT_CANCELED) @map("cancellation_status")

  trusteeId String?  @map("trustee_id")
  trustee   Trustee? @relation(fields: [trusteeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([foreclosureCaseId])
  @@index([saleDate])
  @@map("foreclosure_sales")
}

model Loan {
  id                             String   @id @default(uuid())
  foreclosureCaseId              String   @unique @map("foreclosure_case_id")
  foreclosureCase                ForeclosureCase @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)

  originalLenderOrgId    String?       @map("original_lender_org_id")
  originalLender         Organization? @relation("LoanOriginalLender", fields: [originalLenderOrgId], references: [id], onDelete: SetNull)
  currentMortgageeOrgId  String?       @map("current_mortgagee_org_id")
  currentMortgagee       Organization? @relation("LoanCurrentMortgagee", fields: [currentMortgageeOrgId], references: [id], onDelete: SetNull)
  mortgageServicerOrgId  String?       @map("mortgage_servicer_org_id")
  mortgageServicer       Organization? @relation("LoanServicer", fields: [mortgageServicerOrgId], references: [id], onDelete: SetNull)

  originalPrincipalAmountCents   Int?      @map("original_principal_amount_cents")
  originalLoanDate                DateTime? @map("original_loan_date")
  deedOfTrustDate                  DateTime? @map("deed_of_trust_date")
  instrumentNumber                  String?   @map("instrument_number")
  recordingDate                      DateTime? @map("recording_date")
  loanMaturityDate                    DateTime? @map("loan_maturity_date")
  currentPrincipalBalanceCents      Int?      @map("current_principal_balance_cents")

  estimatedRemainingBalanceCents Int?    @map("estimated_remaining_balance_cents")
  remainingBalanceMethodology    String? @map("remaining_balance_methodology")
  remainingBalanceConfidence     Float?  @map("remaining_balance_confidence")
  remainingBalanceAssumptions    Json?   @map("remaining_balance_assumptions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([originalPrincipalAmountCents])
  @@map("loans")
}

// ─────────────────────────────────────────────────────────────────────────
// Property & address resolution
// ─────────────────────────────────────────────────────────────────────────

model Property {
  id       String @id @default(uuid())
  countyId String @map("county_id")
  county   County @relation(fields: [countyId], references: [id], onDelete: Cascade)

  propertyStreetAddress String? @map("property_street_address")
  city                   String?
  state                  String  @default("TX")
  zipCode                String? @map("zip_code")
  legalDescription       String? @map("legal_description")
  subdivision            String?
  lot                    String?
  block                  String?
  acreage                Float?
  propertyIdNumber       String? @map("property_id_number")
  geographicId           String? @map("geographic_id")
  latitude               Float?
  longitude              Float?

  propertyType           PropertyType           @default(UNKNOWN) @map("property_type")
  classification         PropertyClassification @default(UNKNOWN)

  appraisedValueCents      Int?      @map("appraised_value_cents")
  assessedValueCents       Int?      @map("assessed_value_cents")
  estimatedMarketValueCents Int?     @map("estimated_market_value_cents")
  lastSaleDate              DateTime? @map("last_sale_date")
  lastSalePriceCents        Int?      @map("last_sale_price_cents")

  addressResolutionMethod      AddressResolutionMethod @default(UNRESOLVED) @map("address_resolution_method")
  addressResolutionConfidence  Float?                  @map("address_resolution_confidence")
  addressResolutionExplanation String?                 @map("address_resolution_explanation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  foreclosureCases  ForeclosureCase[]
  addressCandidates PropertyAddress[]
  savedBy           SavedProperty[]
  appraisalValueHistory AppraisalValueHistory[]
  valuations        PropertyValuation[]

  @@index([countyId])
  @@index([city])
  @@index([zipCode])
  @@index([propertyType])
  @@index([classification])
  @@index([addressResolutionConfidence])
  @@index([appraisedValueCents])
  @@map("properties")
}

/// One row per candidate address match considered during resolution.
/// `isSelected` marks the winner; keeping the losers preserves the
/// "conflicting-match handling" trail for manual review / audit.
model PropertyAddress {
  id                String           @id @default(uuid())
  foreclosureCaseId String           @map("foreclosure_case_id")
  foreclosureCase   ForeclosureCase  @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)
  propertyId        String?          @map("property_id")
  property          Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  rawAddressText String
  method         AddressResolutionMethod
  confidence     Float
  explanation    String?
  isSelected     Boolean                 @default(false) @map("is_selected")
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([foreclosureCaseId])
  @@map("property_addresses")
}

model LegalDescription {
  id                 String           @id @default(uuid())
  foreclosureCaseId  String           @map("foreclosure_case_id")
  foreclosureCase    ForeclosureCase  @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)
  sourceDocumentId   String?          @map("source_document_id")
  sourceDocument     SourceDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  rawText        String
  subdivision    String?
  lot            String?
  block          String?
  acreage        Float?
  surveyName     String? @map("survey_name")
  abstractNumber String? @map("abstract_number")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([foreclosureCaseId])
  @@map("legal_descriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// County appraisal-district resolution: candidates, scoring, history
// ─────────────────────────────────────────────────────────────────────────

/// One row per candidate a CountyAppraisalAdapter search returned while
/// trying to resolve a case's property. Richer than PropertyAddress (which
/// only tracks the winning address text) — this is the full appraisal-roll
/// snapshot the scoring engine and the admin review screen need, including
/// the losing candidates and *why* they lost (conflictingFields).
model AppraisalPropertyCandidate {
  id                    String          @id @default(uuid())
  foreclosureCaseId     String          @map("foreclosure_case_id")
  foreclosureCase       ForeclosureCase @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)

  /// The CountyAppraisalAdapter.countyCode that produced this candidate (e.g. "hidalgo-tx").
  countyAppraisalSourceKey String  @map("county_appraisal_source_key")
  sourcePropertyId         String  @map("source_property_id")
  sourceUrl                String? @map("source_url")

  ownerName          String? @map("owner_name")
  situsAddress       String? @map("situs_address")
  city               String?
  zipCode            String? @map("zip_code")
  parcelId           String? @map("parcel_id")
  geographicId       String? @map("geographic_id")
  legalDescription   String? @map("legal_description")
  subdivision        String?
  lot                String?
  block              String?
  acreage            Float?
  classification     PropertyClassification @default(UNKNOWN)

  landValueCents         Int? @map("land_value_cents")
  improvementValueCents  Int? @map("improvement_value_cents")
  appraisedValueCents    Int? @map("appraised_value_cents")
  assessedValueCents     Int? @map("assessed_value_cents")
  marketValueCents       Int? @map("market_value_cents")
  homestead              Boolean?
  taxYear                Int?     @map("tax_year")
  latitude               Float?
  longitude              Float?

  score              Float?
  matchedFields      String[] @default([]) @map("matched_fields")
  conflictingFields  String[] @default([]) @map("conflicting_fields")
  isSelected         Boolean  @default(false) @map("is_selected")

  retrievedAt DateTime @default(now()) @map("retrieved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([foreclosureCaseId])
  @@index([countyAppraisalSourceKey])
  @@map("appraisal_property_candidates")
}

/// Cache + reuse index: once a legal description has been successfully
/// matched to a CAD property (auto-accepted or admin-approved), later
/// foreclosure cases carrying the same normalized legal description reuse
/// that match (a single getPropertyDetails() refresh call) instead of
/// re-running a full multi-strategy CAD search. Powers "do not repeatedly
/// search the CAD for the same foreclosure" and "reuse previous
/// successful matches whenever appropriate."
model ResolvedLegalDescriptionMatch {
  id       String @id @default(uuid())
  countyId String @map("county_id")
  county   County @relation(fields: [countyId], references: [id], onDelete: Cascade)

  /// Normalized subdivision|lot|block (or normalized raw legal text when
  /// subdivision is unavailable) — see buildLegalDescriptionCacheKey().
  normalizedKey            String @map("normalized_key")
  countyAppraisalSourceKey String @map("county_appraisal_source_key")
  sourcePropertyId         String @map("source_property_id")
  situsAddress             String? @map("situs_address")
  confidence               Float
  timesReused              Int    @default(0) @map("times_reused")

  createdAt        DateTime @default(now()) @map("created_at")
  lastConfirmedAt  DateTime @default(now()) @map("last_confirmed_at")

  @@unique([countyId, normalizedKey])
  @@index([countyId])
  @@map("resolved_legal_description_matches")
}

/// One row per full resolver run for a case — a durable copy of the
/// PropertyResolutionResult, independent of the (mutable) Property row it
/// eventually writes to. Gives the admin screen and audit trail a history
/// even across re-runs ("search again").
model PropertyResolutionAttempt {
  id                 String          @id @default(uuid())
  foreclosureCaseId  String          @map("foreclosure_case_id")
  foreclosureCase    ForeclosureCase @relation(fields: [foreclosureCaseId], references: [id], onDelete: Cascade)

  resolutionMethod     AddressResolutionMethod
  confidence           Float
  explanation          String
  matchedFields        String[] @default([]) @map("matched_fields")
  conflictingFields    String[] @default([]) @map("conflicting_fields")
  candidateCount       Int      @default(0) @map("candidate_count")
  requiresManualReview Boolean  @default(false) @map("requires_manual_review")
  selectedCandidateId  String?  @map("selected_candidate_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([foreclosureCaseId])
  @@map("property_resolution_attempts")
}

/// Append-only annual appraisal values — never overwritten, so a property's
/// value history across tax years is preserved instead of only keeping the
/// latest snapshot on Property.appraisedValueCents.
model AppraisalValueHistory {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  taxYear                Int      @map("tax_year")
  landValueCents          Int?     @map("land_value_cents")
  improvementValueCents   Int?     @map("improvement_value_cents")
  appraisedValueCents     Int?     @map("appraised_value_cents")
  assessedValueCents      Int?     @map("assessed_value_cents")
  marketValueCents        Int?     @map("market_value_cents")
  homestead               Boolean?
  exemptions               String[] @default([])
  /// Source's own certified-vs-working-year indicator when available (e.g.
  /// Hidalgo CAD's `valueReady` flag: false for the not-yet-certified
  /// current appraisal year, true for a certified prior year). Null when
  /// the source doesn't expose this distinction.
  certified               Boolean? @map("certified")

  sourceUrl   String?  @map("source_url")
  retrievedAt DateTime @default(now()) @map("retrieved_at")

  @@unique([propertyId, taxYear])
  @@index([propertyId])
  @@map("appraisal_value_history")
}

// ─────────────────────────────────────────────────────────────────────────
// Property valuation providers (county record / licensed AVM / Zillow /
// internal estimate) — see packages/types PropertyValuationProvider.
// ─────────────────────────────────────────────────────────────────────────

/// One row per (provider, retrieval) — never overwritten, so a "stale
/// valuation cleanup" job has rows to act on and the UI can show a value's
/// actual retrieval date rather than "now."
model PropertyValuation {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  providerKey         String        @map("provider_key")
  providerPropertyId  String?       @map("provider_property_id")
  valuationType       ValuationType @map("valuation_type")

  valueCents     Int
  lowRangeCents  Int? @map("low_range_cents")
  highRangeCents Int? @map("high_range_cents")
  confidence     Float?

  effectiveDate DateTime? @map("effective_date")
  retrievedAt   DateTime  @default(now()) @map("retrieved_at")
  sourceUrl     String?   @map("source_url")
  attributionText String? @map("attribution_text")
  methodology     String?

  licenseAllowsDisplay Boolean   @default(true) @map("license_allows_display")
  licenseAllowsStorage Boolean   @default(true) @map("license_allows_storage")
  expiresAt            DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([providerKey])
  @@index([valuationType])
  @@map("property_valuations")
}

// ─────────────────────────────────────────────────────────────────────────
// Field-level provenance (the generic "SourcedField" table)
// ─────────────────────────────────────────────────────────────────────────

/// One row per extracted/derived field value, carrying exactly the metadata
/// described by SourcedField<T> in the product spec. `entityType`+`entityId`
/// point at the owning row (e.g. "ForeclosureCase" / <uuid>, "Loan" / <uuid>,
/// "Property" / <uuid>). The UI joins this table to render source badges.
model ExtractedField {
  id               String           @id @default(uuid())
  sourceDocumentId String?          @map("source_document_id")
  sourceDocument   SourceDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  entityType       String           @map("entity_type")
  entityId         String           @map("entity_id")
  fieldName        String           @map("field_name")
  value            String?
  sourceType       FieldSourceType  @map("source_type")
  sourceUrl        String?          @map("source_url")
  confidence       Float?
  verifiedAt       DateTime?        @map("verified_at")
  methodology      String?
  explicitlyStated Boolean          @default(false) @map("explicitly_stated")
  supportingText   String?          @map("supporting_text")
  pageNumber       Int?             @map("page_number")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([sourceDocumentId])
  @@map("extracted_fields")
}

// ─────────────────────────────────────────────────────────────────────────
// Jobs, review queue, cost control
// ─────────────────────────────────────────────────────────────────────────

model ProcessingJob {
  id                String              @id @default(uuid())
  type              ProcessingJobType
  status            ProcessingJobStatus @default(PENDING)
  sourceDocumentId  String?             @map("source_document_id")
  sourceDocument    SourceDocument?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  foreclosureCaseId String?             @map("foreclosure_case_id")
  foreclosureCase   ForeclosureCase?    @relation(fields: [foreclosureCaseId], references: [id], onDelete: SetNull)
  countySourceId    String?             @map("county_source_id")
  countySource      CountySource?       @relation(fields: [countySourceId], references: [id], onDelete: SetNull)

  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  lastError   String?  @map("last_error")
  costCents   Int      @default(0) @map("cost_cents")
  payload     Json?
  runAt       DateTime @default(now()) @map("run_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@index([type])
  @@map("processing_jobs")
}

model ManualReviewTask {
  id                 String                 @id @default(uuid())
  sourceDocumentId   String?                @map("source_document_id")
  sourceDocument     SourceDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  foreclosureCaseId  String?                @map("foreclosure_case_id")
  foreclosureCase    ForeclosureCase?       @relation(fields: [foreclosureCaseId], references: [id], onDelete: SetNull)

  reason           ManualReviewReason
  status           ManualReviewTaskStatus @default(OPEN)
  assignedToId     String?                @map("assigned_to_id")
  assignedTo       Profile?               @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  resolvedAt       DateTime?              @map("resolved_at")

  @@index([status])
  @@map("manual_review_tasks")
}

model BudgetLimit {
  id                String   @id @default(uuid())
  key               String   @unique
  limitCents        Int      @map("limit_cents")
  alertThresholdPct Int      @default(80) @map("alert_threshold_pct")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("budget_limits")
}

// ─────────────────────────────────────────────────────────────────────────
// User-facing: saved properties, exports, corrections, audit
// ─────────────────────────────────────────────────────────────────────────

model SavedProperty {
  id         String   @id @default(uuid())
  profileId  String   @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([profileId, propertyId])
  @@map("saved_properties")
}

model ExportJob {
  id           String         @id @default(uuid())
  profileId    String         @map("profile_id")
  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  filterParams Json           @map("filter_params")
  rowCount     Int?           @map("row_count")
  status       ExportJobStatus @default(PENDING)
  storageKey   String?        @map("storage_key")
  createdAt    DateTime       @default(now()) @map("created_at")
  completedAt  DateTime?      @map("completed_at")

  @@map("export_jobs")
}

model CorrectionReport {
  id                 String            @id @default(uuid())
  profileId          String?           @map("profile_id")
  profile            Profile?          @relation("CorrectionReportedBy", fields: [profileId], references: [id], onDelete: SetNull)
  propertyId         String?           @map("property_id")
  foreclosureCaseId  String?           @map("foreclosure_case_id")
  foreclosureCase    ForeclosureCase?  @relation(fields: [foreclosureCaseId], references: [id], onDelete: SetNull)
  fieldName          String?           @map("field_name")
  description        String
  status             CorrectionStatus  @default(OPEN)
  createdAt          DateTime          @default(now()) @map("created_at")
  resolvedAt         DateTime?         @map("resolved_at")
  resolvedById       String?           @map("resolved_by_id")
  resolvedBy         Profile?          @relation("CorrectionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("correction_reports")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actor         Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications (platform-neutral model; delivery adapters live in code)
// ─────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id                String                   @id @default(uuid())
  profileId         String                   @unique @map("profile_id")
  profile           Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  emailEnabled      Boolean                  @default(true) @map("email_enabled")
  webPushEnabled    Boolean                  @default(false) @map("web_push_enabled")
  expoPushEnabled   Boolean                  @default(false) @map("expo_push_enabled")
  eventTypesEnabled NotificationEventType[]  @default([NEW_MATCHING_PROPERTY, SALE_DATE_CHANGED, SALE_CANCELED, UPCOMING_AUCTION_REMINDER]) @map("event_types_enabled")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationEvent {
  id                String                @id @default(uuid())
  profileId         String                @map("profile_id")
  profile           Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type              NotificationEventType
  payload           Json?
  deliveredChannels NotificationChannel[] @default([]) @map("delivered_channels")
  createdAt         DateTime              @default(now()) @map("created_at")
  readAt            DateTime?             @map("read_at")

  @@index([profileId, createdAt])
  @@map("notification_events")
}
