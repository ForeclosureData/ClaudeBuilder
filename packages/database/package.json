{
  "name": "@foreclosuredata/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:rls": "prisma db execute --file sql/rls.sql --schema prisma/schema.prisma",
    "generate": "prisma generate",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/database": "^1.0.0",
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^5.17.0",
    "@prisma/client": "^5.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/ws": "^8.5.12",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
